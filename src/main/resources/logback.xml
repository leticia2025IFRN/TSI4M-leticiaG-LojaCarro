<configuration>
    <appender name="FILE" class="ch.qos.logback.core.FileAppender" >
        <file>app.log</file>
        <encoder>
           <pattern>%d{yyyy-MM-dd_HH:mm:ss}_[%thread]_%-5level_%logger{36}_%msg%n</pattern>
        </encoder>
    </appender>
    <root level="info">
        <appender-ref ref="FILE" />
    </root>
</configuration>